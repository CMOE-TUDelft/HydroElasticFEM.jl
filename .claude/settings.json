{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "cmoe-researchos": {
      "source": {
        "source": "github",
        "repo": "CMOE-TUDelft/CMOE-ResearchOS-plugin"
      }
    }
  },
  "enabledPlugins": {
    "cmoe-researchos@cmoe-researchos": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git merge *)",
      "Bash(git tag *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)"
    ]
  }
}
